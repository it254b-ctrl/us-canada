---
import Base from '../layouts/Base.astro';
import StopCard from '../components/StopCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { ALL, HIGHWAYS, FILTERS } from '../lib/regions.js';
import { query, ORDER } from '../lib/db.js';
const top = await query(Astro.locals, `SELECT * FROM stops WHERE 1=1${ORDER} LIMIT 6`);
const counts = await query(Astro.locals, 'SELECT state_province code, COUNT(*) n FROM stops GROUP BY state_province');
const n = Object.fromEntries(counts.map((c) => [c.code, c.n]));
const regions = ALL.filter((r) => n[r.code]);
---
<Base title="Truck Parking & Overnight Rest Stops | US and Canada">
  <h1 class="text-3xl font-extrabold leading-tight">Find a place to park tonight</h1>
  <p class="mt-1 text-mute">Search truck parking by city, state or province, or highway.</p>
  <input id="q" type="search" placeholder="Dallas, TX · I-80 · Ontario" autocomplete="off"
    class="mt-4 w-full rounded-lg border-2 border-line bg-panel px-4 py-4 text-lg placeholder:text-mute focus:border-sign focus:outline-none" />
  <div id="pills" class="mt-3 flex gap-2 overflow-x-auto pb-2">
    <button data-f="" class="pill shrink-0 rounded-full border border-sign bg-sign px-4 py-2 text-sm font-semibold text-ink">All</button>
    {Object.entries(FILTERS).map(([k, [, label]]) => <button data-f={k} class="pill shrink-0 rounded-full border border-line px-4 py-2 text-sm font-semibold">{label}</button>)}
  </div>
  <AdBanner slot="top" />
  <section id="results" class="mt-4 grid gap-3" aria-live="polite">
    {top.map((s) => <StopCard stop={s} />)}
    {top.length === 0 && <p class="text-mute">No lots yet. Run the seed script from the README.</p>}
  </section>
  <section class="mt-10">
    <h2 class="text-xl font-bold">Browse by highway</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      {HIGHWAYS.map((h) => <a href={`/?q=${encodeURIComponent(h)}`} class="rounded border-2 border-road px-3 py-1.5 font-extrabold hover:border-sign hover:text-sign">{h}</a>)}
    </div>
  </section>
  <section class="mt-10">
    <h2 class="text-xl font-bold">Browse by state or province</h2>
    <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
      {regions.map((r) => <a href={`/region/${r.slug}`} class="rounded border border-line bg-panel px-3 py-3 hover:border-sign"><span class="font-semibold">{r.name}</span> <span class="text-mute">({n[r.code]})</span></a>)}
    </div>
  </section>
  <script is:inline>
    const q = document.getElementById('q'), out = document.getElementById('results');
    let f = '', t;
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const card = (s) => `<a href="/stop/${esc(s.slug)}" class="block rounded-lg border p-4 ${s.is_featured ? 'border-sign' : 'border-line'} bg-panel hover:border-sign">${s.is_featured ? '<span class="mb-2 inline-block rounded bg-sign px-2 py-0.5 text-xs font-extrabold text-ink">Featured Lot</span>' : ''}<div class="text-lg font-bold">${esc(s.name)}</div><div class="text-mute">${esc(s.city)}, ${esc(s.state_province)}${s.highway ? ' · ' + esc(s.highway) : ''}${s.exit_number ? ' exit ' + esc(s.exit_number) : ''}</div>${s.total_spaces ? `<div class="mt-2 text-sm">${s.total_spaces} spaces</div>` : ''}</a>`;
    async function run() {
      const r = await fetch(`/api/stops?q=${encodeURIComponent(q.value)}&f=${f}`);
      const rows = await r.json();
      out.innerHTML = rows.length ? rows.map(card).join('') : '<p class="text-mute">No lots match. Try a nearby city or a highway name.</p>';
    }
    const go = () => { clearTimeout(t); t = setTimeout(run, 200); };
    q.addEventListener('input', go);
    document.querySelectorAll('.pill').forEach((b) => b.addEventListener('click', () => {
      f = b.dataset.f;
      document.querySelectorAll('.pill').forEach((x) => { const on = x === b; x.classList.toggle('bg-sign', on); x.classList.toggle('text-ink', on); x.classList.toggle('border-sign', on); x.classList.toggle('border-line', !on); });
      run();
    }));
    const init = new URLSearchParams(location.search).get('q');
    if (init) { q.value = init; run(); }
  </script>
</Base>
