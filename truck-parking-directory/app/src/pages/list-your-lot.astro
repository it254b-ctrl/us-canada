---
import Base from '../layouts/Base.astro';
const field = 'mt-1 w-full rounded-lg border-2 border-line bg-panel px-3 py-3 focus:border-sign focus:outline-none';
---
<Base title="List Your Truck Parking Lot | Free or Featured Placement" description="Submit your truck parking yard for free or request featured top placement.">
  <h1 class="text-3xl font-extrabold">List your lot</h1>
  <p class="mt-1 text-mute">Listing is free. Featured lots are pinned to the top of their city and state pages.</p>
  <form id="f" class="mt-5 grid gap-4">
    <label>Business name<input name="business_name" required class={field} /></label>
    <label>Contact email<input name="contact_email" type="email" required class={field} /></label>
    <label>Phone<input name="phone" type="tel" class={field} /></label>
    <div class="grid grid-cols-2 gap-3">
      <label>City<input name="city" required class={field} /></label>
      <label>State or province code<input name="state_province" required maxlength="2" placeholder="TX" class={field} /></label>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <label>Highway<input name="highway" placeholder="I-80" class={field} /></label>
      <label>Truck spaces<input name="total_spaces" type="number" min="0" class={field} /></label>
    </div>
    <label class="flex items-center gap-3"><input name="wants_featured" type="checkbox" class="h-5 w-5" /> I want Featured Top Placement</label>
    <label>Notes<textarea name="notes" rows="3" class={field}></textarea></label>
    <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <button class="rounded-lg bg-sign px-4 py-4 text-lg font-extrabold text-ink">Submit my lot</button>
    <p id="msg" class="font-semibold" role="status"></p>
  </form>
  <script is:inline>
    const f = document.getElementById('f'), msg = document.getElementById('msg');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = Object.fromEntries(new FormData(f)); d.wants_featured = f.wants_featured.checked;
      msg.textContent = 'Sending...';
      try {
        const r = await fetch('/api/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) });
        const j = await r.json();
        if (r.ok) { msg.textContent = 'Submitted. We will email you within a few days.'; f.reset(); } else msg.textContent = j.error || 'Something went wrong. Check the form and try again.';
      } catch { msg.textContent = 'Network error. Try again.'; }
    });
  </script>
</Base>
