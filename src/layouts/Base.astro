---
import { ADSENSE_CLIENT_ID } from '../config/monetization.js';
const { title, description = 'Find truck parking and overnight rest stops across the US and Canada.', jsonld } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.url.origin).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta name="theme-color" content="#0b0d10" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {ADSENSE_CLIENT_ID && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`} crossorigin="anonymous"></script>}
</head>
<body class="bg-ink text-road antialiased min-h-screen" style="font-family: system-ui, 'Segoe UI', Roboto, Arial, sans-serif">
  <header class="border-b-4 border-sign bg-panel">
    <div class="mx-auto max-w-4xl px-4 py-3 flex items-center justify-between">
      <a href="/" class="text-xl font-extrabold tracking-tight text-sign">Truck Lot Finder</a>
      <a href="/list-your-lot" class="text-sm font-semibold underline underline-offset-4 hover:text-sign">List your lot</a>
    </div>
  </header>
  <main class="mx-auto max-w-4xl px-4 py-6"><slot /></main>
  <footer class="border-t border-line mt-10 py-6 text-center text-sm text-mute">
    Always confirm parking availability before you route. <a class="underline" href="/list-your-lot">Add or feature a lot</a>
  </footer>
</body>
</html>
