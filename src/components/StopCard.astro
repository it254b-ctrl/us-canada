---
const { stop } = Astro.props;
const tags = [[stop.is_free, 'Free'], [stop.is_24_7, '24/7'], [stop.has_showers, 'Showers'], [stop.has_security, 'Security'], [stop.has_wifi, 'Wi-Fi'], [stop.has_diesel, 'Diesel']].filter(([on]) => on);
---
<a href={`/stop/${stop.slug}`} class={`block rounded-lg border p-4 ${stop.is_featured ? 'border-sign bg-panel' : 'border-line bg-panel'} hover:border-sign focus:outline focus:outline-2 focus:outline-sign`}>
  {stop.is_featured ? <span class="mb-2 inline-block rounded bg-sign px-2 py-0.5 text-xs font-extrabold text-ink">Featured Lot</span> : null}
  <div class="text-lg font-bold">{stop.name}</div>
  <div class="text-mute">{stop.city}, {stop.state_province}{stop.highway ? ` · ${stop.highway}` : ''}{stop.exit_number ? ` exit ${stop.exit_number}` : ''}</div>
  {stop.featured_tagline ? <div class="mt-1 text-sm text-sign">{stop.featured_tagline}</div> : null}
  <div class="mt-3 flex flex-wrap gap-1.5 text-xs">
    {stop.total_spaces ? <span class="rounded border border-line px-2 py-1 font-semibold">{stop.total_spaces} spaces</span> : null}
    {tags.map(([, t]) => <span class="rounded border border-line px-2 py-1">{t}</span>)}
  </div>
</a>
